{
  "name": "objectiveweb/db",
  "type": "library",
  "description": "Database Abstraction Layer and Management Frontend",
  "keywords": [
    "db",
    "sql",
    "ui"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Guilherme Barile",
      "homepage": "https://guigouz.github.io"
    }
  ],
  "require": {
    "php": ">=8.0",
    "doctrine/dbal": "^3.10 || ^4.0",
    "objectiveweb/router": "dev-devel",
    "objectiveweb/dice": "dev-master"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:objectiveweb/router.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:objectiveweb/dice.git"
    }
  ],
  "autoload": {
    "psr-4": {"Objectiveweb\\": "src/"}
  },
  "suggest": {
    "robmorgan/phinx": "To write migrations",
    "objectiveweb/router": "To expose the DB API"
  }
}
